{
  "name": "vivijure-control-plane",
  "version": "1.24.0",
  "private": true,
  "description": "Hosted control plane for Vivijure Studio: tenancy, onboarding, provisioning",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "guard:resolve": "node scripts/resolve-guard.mjs",
    "check:pins": "node scripts/check-satellite-pins.mjs",
    "check:pins:prod": "node scripts/check-satellite-pins.mjs --prod",
    "check:studio-pin": "node scripts/check-studio-pin.mjs",
    "check:studio-pin:deployed": "node scripts/check-studio-pin.mjs --deployed",
    "guards:config": "bash tests/render-wrangler.test.sh",
    "guards:aup": "bash tests/aup-pin-gate.test.sh",
    "test": "vitest run",
    "test:live:scratch": "vitest run tests/runpod.live.test.ts tests/cf-api.live.test.ts",
    "smoke:predeploy": "vitest run tests/pre-deploy-smoke.live.test.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
