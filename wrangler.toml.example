# Vivijure CONTROL PLANE -- wrangler config.
#
# THE TEMPLATE, not the config. The real wrangler.toml is RENDERED from this file at deploy time
# (.github/workflows/deploy.yml, envsubst) and is gitignored: this repo is PUBLIC, and the rendered
# file carries the account id, the D1 id, and the zone facts. Edit THIS file; render locally to work.
#
# Deployed by a v* tag on THIS repository (cf#85 split the tag semantics: a v* tag here deploys the
# control plane, a v* tag in vivijure-cf deploys the Studio panel). The old manual
# `npm run deploy:control-plane` path is retired -- hand-deploying is how the D1 ledger drifted in
# the first place (cf#80).
#
# account_id is NOT hardcoded; it is read from CLOUDFLARE_ACCOUNT_ID (.dev.vars locally, injected
# in CI). Mirror every binding change in src/env.ts (the hand-authored Env).
#
# NAMING: "control-plane", never "platform". src/platform/ is already the host-neutral Platform ICD
# (cf-platform.ts, cf-r2-store.ts, ...), and colliding with it would be a trap for the next reader.
#
# PARITY: this control plane is AGPL in this public repo like everything else it provisions. It
# deploys the PUBLISHED studio release unmodified, so there is no hosted fork to drift from
# self-host. Anyone may run a competing hosted vivijure from exactly this source.
#
# NAMING NOTE, now obsolete but kept for readers coming from vivijure-cf: the old config warned
# against calling this Worker "platform" because src/platform/ in THAT repo is the host-neutral
# Platform ICD. That collision does not exist here; the name stays control-plane regardless.

name = "vivijure-control-plane"
main = "src/index.ts"
compatibility_date = "2026-06-01"
compatibility_flags = ["nodejs_compat"]

# No preview URLs, and no workers.dev: the front door is studio.vivijure.com. A *.workers.dev
# hostname would be a second, unrouted way into signup and the admin surface.
preview_urls = false
workers_dev = false

# --- Front-door assets ---
#
# POSITION IS LOAD-BEARING. `assets` is a BARE key, so TOML binds it to whatever table header
# precedes it. It lived below `[observability]` from #46 until 2026-07-19 and was therefore parsed
# as `observability.assets`: the top-level ASSETS binding was never created, `env.ASSETS.fetch()`
# threw on undefined, and studio.vivijure.com served 500 on `/` and every HTML path while the JSON
# routes stayed green. Production had no user-visitable page for three days and nothing failed.
# Keep every bare top-level key ABOVE the first table header. wrangler's only complaint was a
# scroll-past WARNING: `Unexpected fields found in observability field: "assets"`.
#
# The front-door UI (Joan, #58). Deliberately a SEPARATE bundle from public/ (the studio frontend
# that ships to every self-hoster): the hosted door is ours, the studio is everyone's.
#
# run_worker_first = true is LOAD-BEARING, and not for the reason the core needs it.
#
# Without it, Workers Assets serves matching paths STRAIGHT FROM THE EDGE, bypassing the Worker --
# so on this Worker every tenant hostname served the front-door HTML at `/` and at every asset path,
# and the #55 tenant routing never ran. Three consequences, all found on the real deploy (2026-07-17)
# and none catchable by the unit suite, which never sees the asset layer:
#   1. A SUSPENDED tenant's `/` returned the front door instead of the 403. The kill switch was
#      bypassed for exactly the paths a human visits.
#   2. A live tenant's studio root would serve the CONTROL PLANE's front door instead of that
#      tenant's studio. The hosted product would be broken at its most-used URL.
#   3. The dark deploy was not dark: signup UI was reachable at any-hostname.studio.vivijure.com/
#      even with the front-door Custom Domain deliberately unpublished.
# The core hit the same class and documents it in wrangler.toml.example ("the post-v0.7.4 finding").
# This is that lesson, re-learned on a second Worker.
#
# Safe here because the router already ends in `env.ASSETS.fetch(request)` (src/index.ts),
# which is the same worker-serves-assets pattern the core runs in production. html_handling is left at
# the default deliberately: the core needs "none" because it maps pretty URLs itself, whereas this
# Worker wants the default `/` -> index.html behavior.
assets = { directory = "./public", binding = "ASSETS", run_worker_first = true }

# >>> SELFHOST-SKIP: tail-consumer -- OUR-fleet Loki path via vivijure-tail
# TOP-LEVEL bare key (same class as assets): must sit ABOVE the first table header or TOML nests it.
# Stripped by scripts/render-wrangler.sh unless KEEP_FLEET_ONLY=1 (cp#48).
# Self-hosters: leave stripped; a dangling tail_consumers name fails `wrangler deploy` outright.
# Skyphusion fleet deploy sets KEEP_FLEET_ONLY=1 so this block survives into the rendered toml.
tail_consumers = [ { service = "vivijure-tail" } ]
# <<< SELFHOST-SKIP: tail-consumer

# --- Observability (Workers Logs) ---
#
# Turns on Workers Logs for this Worker: invocation summaries, status, timings, and console output,
# retained 7 days and queryable from the dashboard Observability tab and the CF obs query API.
# Included on both Free and Paid; we are Paid (20M events/month included, then $0.60/million).
#
# head_sampling_rate = 1 is EXPLICIT, not a default worth leaving implicit. The control plane is a
# LOW-volume Worker (signup, admin, provisioning) whose interesting events are rare and individually
# important -- a provision failure or an admin action is exactly the line you cannot afford to have
# been sampled away. Measured constellation volume is ~150k events/month against a 20M allowance
# (see docs/observability.md in vivijure-cf), so full-rate capture here costs nothing and sampling
# would buy nothing.
#
# Dashboard logs only. Loki is the SELFHOST-SKIP tail_consumers block above (cp#48).
[observability]
enabled = true
head_sampling_rate = 1

# cp#289: Worker version metadata. Unique `id` + `timestamp` per deploy, so GET
# /api/platform/version can distinguish two deploys of the same release tag. Bound as
# CF_VERSION_METADATA; mirrored optional on ControlPlaneEnv (absent in unit tests).
[version_metadata]
binding = "CF_VERSION_METADATA"

# Control-plane D1. PLATFORM data only (accounts, tenants, aup_acceptances, provision_jobs).
# Tenant studio data lives in each tenant's OWN D1 and never here; the schema-guard test enforces it.
[[d1_databases]]
binding = "CP_DB"
database_name = "vivijure-control-plane"
database_id = "${CONTROL_PLANE_D1_ID}"
migrations_dir = "migrations"

# Tenant studios: the Workers-for-Platforms dispatch namespace (#55). Each tenant is a user Worker
# in it, named tenant-<slug>-studio (tenants.ts tenantScriptName(); the provisioner creates under
# the same name -- ONE definition, both sides). Mirrored in src/env.ts.
#
# DANGLING-BINDING HAZARD: the namespace must EXIST before this Worker deploys, or `wrangler deploy`
# FAILS. typecheck will not catch it; only a real deploy will. CHECK FIRST -- create is NOT
# idempotent, it errors if the namespace is already there:
#   npx wrangler dispatch-namespace list
#   npx wrangler dispatch-namespace create "${TENANT_DISPATCH_NAMESPACE}"   # only if absent
# DONE on the prod account 2026-07-17 (#55): `vivijure-tenants` exists and is empty. It is NEW and
# SEPARATE from `vivijure-modules` (the Phase-3 module namespace) -- sharing one would collide
# script names and put a module bug inside the tenant blast radius.
[[dispatch_namespaces]]
binding = "TENANT_DISPATCH"
namespace = "${TENANT_DISPATCH_NAMESPACE}"

# Tenant MODULE workers (cf#99) live in their own namespace, and as of cf#114 the control plane DOES
# dispatch to them: the invoke-key route probes each module script GET /ready to prove it actually
# serves the key that was just installed, BEFORE the tenant is flipped live. A dispatch binding is the
# only way to reach a script that has no public route.
#
# DANGLING-BINDING HAZARD, and it is SHARPER here than for TENANT_DISPATCH. `wrangler deploy` FAILS
# on a binding to a namespace that does not exist, and binding the control plane to this one CLOSES
# THE BOOTSTRAP the provisioner used to provide: the provisioner creates this namespace lazily on
# first provision, but the provisioner cannot run until the control plane deploys, and the control
# plane can no longer deploy until the namespace exists. So on a FRESH ACCOUNT the out-of-band create
# below is MANDATORY, not a convenience -- lazy creation can no longer bootstrap you out of it.
# CHECK FIRST; create is NOT idempotent and errors if the namespace is already there:
#   npx wrangler dispatch-namespace list
#   npx wrangler dispatch-namespace create "${TENANT_MODULE_NAMESPACE}"   # only if absent
# On an account that has already provisioned a tenant it exists already (prod: confirmed present).
# Operator procedure lives in docs/deploy-runbook.md; this comment is not where a deploy gets driven.
#
# src/env.ts types this binding OPTIONAL, and it is worth being exact about what that does and does
# NOT buy. It does NOT protect a fresh-account deploy: toml validation is Cloudflare's and tsc has no
# reach there, and since this binding ships UNCOMMENTED in this example, anyone following it deploys
# WITH the binding. What the optional type covers is the one real case left: a deployed toml that
# does not carry this binding at all (an older config), where the probe reports the modules
# unverifiable -- naming the missing binding in its detail -- rather than a false pass.
[[dispatch_namespaces]]
binding = "TENANT_MODULE_DISPATCH"
namespace = "${TENANT_MODULE_NAMESPACE}"

# The studio release artifact mirror studio-release.yml publishes (studio-releases/<tag>/...).
# The provisioner reads the pinned release from here; see src/bundle-r2.ts.
# PREREQ, same class as the dangling-namespace hazard above: the bucket must EXIST and the pinned
# tag artifact must have been published INTO it (run the studio-release workflow) before a provision
# can succeed. An empty mirror fails at the bundle_fetch PRECONDITION, before any tenant resource is
# created, not half way through, and never silently.
#
# The mirror also carries the tenant D1 SCHEMA and the studio env var contract as of the pinned
# release (manifest migrations + required_vars, v1.3.1 and later). That is why there is no .sql
# Text-module rule here any more: nothing in this repo imports .sql at build time. The schema is
# fetched and hash-verified at provision time instead, so a tenant can never be built from a schema
# this repo happened to be carrying.
[[r2_buckets]]
binding = "STUDIO_RELEASES"
bucket_name = "${STUDIO_RELEASES_BUCKET}"

[vars]
# Bumping AUP_VERSION re-gates every account on their next request, by construction.
AUP_VERSION = "${AUP_VERSION}"
# MUST pin an IMMUTABLE ref: a commit SHA or a tag, never main and never a moving path (the
# standing rule from Ernst). An account accepts a SPECIFIC text and the plane records the sha256
# it served; a URL that can change after the fact makes that record unverifiable.
# scripts/render-wrangler.sh refuses a moving ref at deploy time. See docs/deploy.md.
AUP_URL = "${AUP_URL}"
# THE single injected hostname (the vars ruling). The front-door origin and the tenant domain
# suffix are DERIVED from it in src/env.ts (publicOrigin/tenantDomainSuffix), and the
# routes below derive from the same placeholder, so there is exactly ONE hostname fact in the whole
# deployment. Strummer's reasoning stands and is why this went further: two independently-injected
# hostnames WILL diverge, and the failure is nasty (magic links pointing at a host this Worker is
# not routed on). Deriving the SUFFIX too closes the last gap -- it was still independently
# settable, which is the same bug wearing a different name.
#
# The coupling this accepts, stated plainly: tenant hostnames must be CHILDREN of the front-door
# host (<tenant>.studio.<root> under studio.<root>). That is the ruled shape and holds for any
# self-host (<tenant>.panel.example.com under panel.example.com). A deployment wanting tenants on
# an unrelated domain would need the suffix injected again; nobody has asked for that, and the
# drift class it reopens is worse than the flexibility it buys.
CONTROL_PLANE_HOST = "${CONTROL_PLANE_HOST}"
# postern's send door (POST /api/send). A URL, not a secret.
POSTERN_SEND_URL = "${POSTERN_SEND_URL}"
# SSO client identifiers are public; their secrets are wrangler secrets (below). A provider is
# OFFERED only when both halves are present, so an unconfigured provider is absent, not broken.
GOOGLE_OAUTH_CLIENT_ID = "${GOOGLE_OAUTH_CLIENT_ID}"
GITHUB_OAUTH_CLIENT_ID = "${GITHUB_OAUTH_CLIENT_ID}"
# Apple seam: PARKED until Conrad stages Team ID + Services ID + .p8. Empty = Apple is not offered.
APPLE_TEAM_ID = "${APPLE_TEAM_ID}"
APPLE_SERVICES_ID = "${APPLE_SERVICES_ID}"
# Provisioner wiring (src/deps.ts provisionerWiring). ALL of CF_ACCOUNT_ID,
# DISPATCH_NAMESPACE, STUDIO_RELEASE (+ the STUDIO_RELEASES binding + the CF_PROVISIONER_TOKEN
# secret) must be present or provisioning refuses with 503 provisioner_unconfigured.
# CF_ACCOUNT_ID is the same account fact wrangler itself deploys with; it is a var here because the
# Worker needs it at runtime (CfApi paths + the tenant R2 S3 endpoint) and a Worker cannot read its
# own account id. DISPATCH_NAMESPACE is the same namespace TENANT_DISPATCH binds; the binding
# serves dispatch, the NAME serves the upload API, and they must agree.
# cf#56: the AI Gateway tenant MODULE workers bind as GATEWAY_ID. Set it to the DEDICATED
# hosted-tenant gateway (vivijure-hosted), which runs authentication ON -- verified: a valid
# per-tenant token reaches the provider and a bogus one is refused 401 AT the gateway.
#
# NEVER point this at prism gateway (skyphusion-llm). A shared gateway puts every tenant LLM call
# in one analytics namespace and defeats the per-tenant attribution the token exists to give.
#
# EMPTY IS MEANINGFUL: no gateway named, so plan-enhance runs on the free local Workers AI provider.
# That is a real working fallback, not a degrade -- pickProvider needs GATEWAY_ID and CF_AIG_TOKEN
# both, and the provisioner binds NEITHER when either is missing (tenant-modules.ts).
TENANT_AI_GATEWAY_ID = "${TENANT_AI_GATEWAY_ID}"

# cp#270: the SHARED RunPod endpoint pool, as JSON keyed by PROVISION_PLAN key:
#   {"backend":{"id":"...","name":"..."},"upscale":{...},"lipsync":{...},"audio-upscale":{...}}
#
# EMPTY MEANS THIS PLANE OFFERS NO SHARED TIER, and every tenant must bring its own RunPod key --
# which is exactly the behaviour before pooling existed. Set it and a tenant that brings no key
# rides these endpoints and creates ZERO new ones, which is what lifts the account-wide worker
# quota ceiling off the tenant count.
#
# ALL-OR-NOTHING: a value missing any plan key is REFUSED at wiring time (logged as
# shared_pool.refused) and the plane falls back to offering no shared tier. A partial pool would
# provision a tenant that is green through verify and dies at the first render on the capability
# it has no endpoint for.
#
# The invoke key that can RUN these endpoints is SHARED_RUNPOD_INVOKE_KEY, a worker secret
# (`wrangler secret put`), never a var. Both halves must be present or the tier is not offered.
# TOML LITERAL STRING (single quotes), and it is not a style choice. This value is JSON, so its
# own double quotes would terminate a basic string and the document would not parse -- which is
# exactly what happened the first time anyone set it (cp#285). A literal string does no escape
# processing, so the JSON survives byte for byte. Note the residual: TOML literal strings cannot
# contain a single quote at all, so a value carrying one still renders invalid -- that case is
# caught by the post-render parse assertion in scripts/render-wrangler.sh rather than here.
SHARED_RUNPOD_ENDPOINTS = '${SHARED_RUNPOD_ENDPOINTS}'
# cf#56: alert threshold in BYTES for total R2 across all tenant buckets, on the admin usage
# surface. EMPTY IS MEANINGFUL: no threshold, and the surface reports usage with a `no_threshold`
# verdict rather than inventing a line nobody chose. parseThresholdBytes refuses 0 deliberately --
# a permanently-firing alert is one the operator learns to ignore.
R2_USAGE_ALERT_BYTES = "${R2_USAGE_ALERT_BYTES}"
# cp#192: whether the prepaid credit ledger ENFORCES, or merely counts. EMPTY IS MEANINGFUL and is
# the deliberate default: counting mode, where the ledger records everything and refuses nothing.
# Not fail-closed by default, because no purchase door exists yet, so no tenant CAN hold a positive
# balance and enforcing-by-default would refuse every submission the moment the migration landed.
# Flipping this on is a named acceptance criterion of cp#193 and is a SEPARATE act from wiring
# PayPal: a door in front of a counting ledger sells credits that refuse nothing. Do not set this
# until the purchase path is proven against a real settlement.
CREDITS_ENFORCING = "${CREDITS_ENFORCING}"
# cp#193: ceiling on ONE operator credit, in micro-USD. EMPTY IS MEANINGFUL: the documented default
# (USD 100) applies. A typo catcher rather than a policy -- nobody ruled a maximum comp, and the
# hazard bounded is a stray keystroke turning USD 10.00 into USD 10,000.00 on the one surface that
# mints money from nothing. The refusal names this var, so a larger credit is a deliberate change.
MANUAL_CREDIT_CEILING_MICRO_USD = "${MANUAL_CREDIT_CEILING_MICRO_USD}"
# cp#193: PayPal Business rail. EMPTY IS MEANINGFUL on every one of these: the rail is simply not
# offered. PAYPAL_CLIENT_SECRET is a wrangler secret, never a var. PAYPAL_ENV empty = sandbox.
PAYPAL_CLIENT_ID = "${PAYPAL_CLIENT_ID}"
PAYPAL_WEBHOOK_ID = "${PAYPAL_WEBHOOK_ID}"
PAYPAL_ENV = "${PAYPAL_ENV}"
# Traefik finish doors stamped onto tenant studios. EMPTY = that door is off.
VIDEO_FINISH_URL = "${VIDEO_FINISH_URL}"
AUDIO_MIX_URL = "${AUDIO_MIX_URL}"
AUDIO_BEAT_SYNC_URL = "${AUDIO_BEAT_SYNC_URL}"
IMAGE_PREP_URL = "${IMAGE_PREP_URL}"
AUDIO_MASTER_URL = "${AUDIO_MASTER_URL}"
# Operator spend pricebook JSON. EMPTY = no pricebook bound.
# TOML literal string: the value is JSON (same reason as SHARED_RUNPOD_ENDPOINTS).
SPEND_PRICEBOOK = '${SPEND_PRICEBOOK}'
# cp#183: the per-tenant R2 storage ceiling in BYTES, bound onto every tenant studio as
# R2_STORAGE_QUOTA_BYTES and enforced there at submit (vivijure-core core#52: honest 507 with both
# real numbers, fail-CLOSED 503 if the quota is set and its check cannot run).
#
# EMPTY IS MEANINGFUL: no ceiling. There is deliberately no default -- the number prices what an
# operator is willing to carry per tenant, which is policy this repo does not get to invent, and a
# fallback here would be a pricing decision hidden in a config template.
#
# BYTES ONLY, no unit suffixes (a mis-parsed unit is an order-of-magnitude error on a bill). A
# non-empty value that is not a positive integer REFUSES the provision, the studio upgrade and the
# converge route rather than being rounded down to "off": the studio would read it as no ceiling,
# and "typed it wrong" must not silently become "wanted no ceiling". 107374182400 = 100 GiB.
TENANT_R2_STORAGE_QUOTA_BYTES = "${TENANT_R2_STORAGE_QUOTA_BYTES}"

# cp#195: the INCLUDED LLM allowance per tenant per billing period, in integer MICRO-USD.
# EMPTY means no allowance has been chosen, and the settlement run then reports every tenant
# UNBILLABLE rather than billing them from the first micro-USD. Unset is the absence of a decision,
# not a decision of zero; a configured "0" IS a decision and bills from the first micro-USD.
# Unit is in the NAME because a bare _ALLOWANCE invites someone to put dollars in it.
TENANT_LLM_SPEND_ALLOWANCE_MICRO_USD = "${TENANT_LLM_SPEND_ALLOWANCE_MICRO_USD}"

# cp#195: the per-tenant storage enforcement POSTURE, bound onto tenant studios as
# R2_STORAGE_QUOTA_MODE once the studio-core knob ships. "deny" (default, today's submit-time 507)
# or "meter" (no deny; the bytes knob becomes an INCLUDED quota and the plane bills the overage).
# EMPTY means deny, which is the conservative side: a mistake there costs a late deny rather than
# unmetered spend. Note this is the OPPOSITE default from the BYTES knob above, where empty means
# OFF -- absent knob, absent behaviour is right for a ceiling nobody set, and wrong for a mode that
# still has to pick a posture. Do not "fix" one to match the other.
TENANT_R2_STORAGE_QUOTA_MODE = "${TENANT_R2_STORAGE_QUOTA_MODE}"
CF_ACCOUNT_ID = "${CLOUDFLARE_ACCOUNT_ID}"
DISPATCH_NAMESPACE = "${TENANT_DISPATCH_NAMESPACE}"
# The shared dispatch namespace tenant MODULE workers are uploaded into (cf#99), distinct from
# DISPATCH_NAMESPACE (tenant studios): sharing one would collide script names and put a module
# bug inside the tenant blast radius. The provisioner CREATES it if missing (idempotent), so no
# separate dashboard/wrangler step is needed -- but it is a required var: absent -> provisioning
# refuses 503, same as the rest of this block. Each TENANT studio carries its own MODULE_DISPATCH ->
# this namespace in its upload metadata. As of cf#114 the control plane ALSO binds it, as
# TENANT_MODULE_DISPATCH above, to probe module readiness before flipping a tenant live -- the NAME
# here and that binding must name the same namespace.
TENANT_MODULE_NAMESPACE = "${TENANT_MODULE_NAMESPACE}"
# The pinned studio release every new tenant gets (the golden-checkpoint pin; see the Q4 ruling).
STUDIO_RELEASE = "${STUDIO_RELEASE}"
# cp#218: the per-tenant daily spend ceiling in USD, bound onto every tenant studio as
# SPEND_DAILY_CEILING at provision time. EMPTY IS MEANINGFUL and is the shipped default: the plane
# supplies 25, which is what it has always done (src/deps.ts). This line exists because the var was
# typed in src/env.ts and read in deps.ts while being declared in NO list, so the knob documented as
# operator-tunable could not actually be tuned. Declared empty here changes nothing and makes it
# settable.
TENANT_SPEND_DAILY_CEILING = "${TENANT_SPEND_DAILY_CEILING}"
# cp#45: the operator smoke-render bounds. EMPTY IS MEANINGFUL for all three -- the documented
# default applies (src/smoke-render.ts: 1800s cooldown, 20 renders per rolling 24h, 1200s in-flight),
# and boundFrom() treats a blank as ABSENT rather than as zero, deliberately: this route costs GPU,
# so an unfilled config line must never read as "this bound is off". Same cp#218 story as above --
# typed, read, and declared nowhere, so the bounds could not be moved off their defaults.
SMOKE_RENDER_COOLDOWN_SECONDS = "${SMOKE_RENDER_COOLDOWN_SECONDS}"
SMOKE_RENDER_DAILY_CAP = "${SMOKE_RENDER_DAILY_CAP}"
SMOKE_RENDER_INFLIGHT_SECONDS = "${SMOKE_RENDER_INFLIGHT_SECONDS}"

# cp#95: which installed studio-token KEK NEW ciphertext is written under -- "primary" (the default,
# and the only correct value outside a rotation) or "next". It NAMES a key; it is not one, so it is a
# var rather than a secret.
#
# WHY THIS IS CONFIG AND NOT A RUNTIME TOGGLE. The re-encryption sweep and the live provision path
# must write under the SAME key or the rotation never converges (sweep a row forward, let a provision
# write the next one backward, forever). Making it a deploy-time fact gives that question one home,
# and makes flipping the write direction of every stored customer credential a reviewable change in
# git rather than an unlogged click.
#
# EMPTY IS MEANINGFUL: "primary", the pre-rotation behaviour (kekRing() normalises blank and any
# unrecognised value to primary). Setting it to "next" with no STUDIO_TOKEN_KEK_NEXT installed
# REFUSES to encrypt rather than falling back.
#
# cp#218: this line used to be COMMENTED OUT, which meant the rotation runbook step "set
# STUDIO_TOKEN_KEK_ENCRYPT_SLOT and deploy" was not performable without first editing this template.
# It is a declared, empty-by-default var now, so a rotation is an Actions variable change.
# Full procedure: docs/deploy.md, "Rotating STUDIO_TOKEN_KEK".
STUDIO_TOKEN_KEK_ENCRYPT_SLOT = "${STUDIO_TOKEN_KEK_ENCRYPT_SLOT}"

# Throttles the outbound-email amplifier (/api/auth/email/start).
[[unsafe.bindings]]
name = "CP_RATE_LIMIT"
type = "ratelimit"
namespace_id = "2001"
simple = { limit = 5, period = 60 }

# --- Cron: the per-tenant LLM spend meter (cp#185) ---
#
# Drives the scheduled() handler in src/index.ts, which pages AI Gateway logs from a watermark and
# writes integer micro-USD usage rows the credit ledger bills from.
#
# WHY 5 MINUTES, AND WHY THIS BLOCK USED TO ARGUE FOR 15 (cp#290).
#
# There are now TWO consumers on this cron and only one of them is indifferent to the cadence. The
# reasoning below is preserved rather than replaced, because it was correct for the meter and is
# still the reason the change is cheap -- what moved is that a second consumer arrived for whom the
# interval is a CORRECTNESS parameter, not a bookkeeping one.
#
#   THE METER (unchanged, cadence-indifferent). Gateway retention is COUNT based (10,000,000 rows,
#   DELETE_OLDEST) rather than a time window, so at the hosted Opus call rate no plausible cadence
#   loses rows. Shorter bills in tighter windows but writes a period row per tick forever: 5 minutes
#   is 288 rows a day against 96 at 15. That is the entire cost of this change to the meter, it is
#   pure bookkeeping volume, and period windows TILE off the previous run's recorded instant rather
#   than off this number -- so the interval and the ledger cannot disagree about where a window
#   ended. This block previously rejected 5 minutes on that row count alone. With one consumer that
#   was the right call.
#
#   THE RUNPOD JOB SWEEP (new, and cadence IS correctness). A row becomes eligible at
#   RECONCILER_ADOPT_AFTER_MS (5 min) and becomes unanswerable at RunPod's result retention
#   (30 min, first-party docs), so the window in which a lost job can still be resolved is
#   [t+5, t+30] -- 25 minutes wide. THE NUMBER THAT DECIDES WHETHER THE BACKSTOP WORKS IS HOW MANY
#   ATTEMPTS FIT IN IT:
#
#       at */15 : worst case ticks at t+20, then t+35 -- past retention. ONE attempt.
#       at */5  : worst case ticks at t+10/15/20/25.  FOUR attempts (five when aligned).
#
#   One non-retryable attempt is not a backstop. This sweep exists to catch jobs whose primary
#   mechanism ALREADY failed once, so a single slow tick, D1 blip or RunPod 5xx would make the row
#   permanently `unknown` -- silent, and indistinguishable from a job RunPod genuinely could not
#   answer. 192 extra bookkeeping rows a day is the correct price for that.
#
# Recomputed in src/runpod-job-sweep.ts (SWEEP_ATTEMPTS_PER_ROW) so the arithmetic lives beside the
# constants it is derived from and goes stale loudly rather than silently.
#
# CHANGING IT IS SAFE AND NEEDS NO CODE CHANGE. Period windows TILE off the previous run's recorded
# instant, never off a configured interval, so this number and the ledger can never disagree about
# where one window ended and the next began.
#
# REMOVING IT DISABLES THE METER SILENTLY, which is the one hazard here: nothing else in the system
# notices an absent cron, because "no period rows" is exactly what an idle plane looks like. The
# windowed read is what catches it -- a billing window with no roll-up run assigned to it reports
# complete:false, so a statement built on it refuses rather than bills a zero.
[triggers]
crons = ["*/5 * * * *"]

# SECRETS (wrangler secret put, never in this file):
#   POSTERN_SEND_TOKEN          -- bearer for postern's send door; the sender identity is BOUND to
#                                  this token by postern's registry, so we never pass a From.
#   GOOGLE_OAUTH_CLIENT_SECRET
#   GITHUB_OAUTH_CLIENT_SECRET
#   APPLE_PRIVATE_KEY           -- the .p8; parked with the rest of the Apple seam.
#   CONTROL_PLANE_ADMIN_TOKEN   -- the admin gate. Unset = no admin surface (fails closed).
#   CF_PROVISIONER_TOKEN        -- mints tenant D1 + R2 + scoped creds. Consumed by #53, not #52.
#   AI_GATEWAY_READ_TOKEN       -- cp#185. AI Gateway Read + Metadata Read, nothing else. The LLM
#                                  meter pages gateway logs with it. UNSET = the meter does not run
#                                  and writes NO period rows, which is an honest off: an empty
#                                  period row would be a billable-looking window of zero spend
#                                  manufactured out of a missing secret.

# --- Routing (#55) ---
#
# The front door: a Custom Domain (CF manages its DNS record + certificate), the same pattern the
# core and the MCP Worker use. It needs no ACM pack -- the zone's existing vivijure.com +
# *.vivijure.com advanced pack already covers a FIRST-level host like studio.vivijure.com.
[[routes]]
pattern = "${CONTROL_PLANE_HOST}"
custom_domain = true

# The tenant leg: a WILDCARD route. It canNOT be a custom domain -- Workers Custom Domains do not
# support wildcards (spike-confirmed) -- so it needs BOTH of these live on the zone or it does not
# serve at all:
#   (a) a PROXIED wildcard DNS record for *.<CONTROL_PLANE_HOST>; a Worker route only fires on
#       proxied DNS. House style on this zone is `AAAA -> 100::`, proxied (confirmed against every
#       existing Worker hostname there).
#   (b) a certificate covering *.<CONTROL_PLANE_HOST>. That is a SECOND-level wildcard, which
#       Universal SSL does NOT cover, so it needs an Advanced Certificate Manager pack.
#
# *** RESOLVED as of 2026-07-19, VERIFIED FROM THE EDGE. Both (a) and (b) are live. ***
#
# This block previously read "BLOCKED: ACM is NOT entitled on the vivijure.com zone" (2026-07-17,
# cert-pack quota allocated:0/used:6, ordering returning 1450). That is STALE and was left standing
# after the situation changed the same day. A stale confident headline mis-anchors whoever reads it
# next, so it is corrected here rather than annotated.
#
# Evidence, fetched not inferred (2026-07-19):
#   $ openssl s_client -servername probe.studio.vivijure.com -connect probe.studio.vivijure.com:443
#     subject=CN = vivijure.com   issuer=Google Trust Services WE1   notBefore=Jul 17 13:35:58 2026
#     X509v3 Subject Alternative Name:
#       DNS:vivijure.com, DNS:studio.vivijure.com, DNS:*.studio.vivijure.com
#   $ curl -sS -D - https://probe.studio.vivijure.com/
#     HTTP/2 404 ; content-type: application/json ; server: cloudflare
#
# The SAN carries the SECOND-level wildcard *.studio.vivijure.com, which Universal SSL does not
# cover, so the ACM pack exists and is serving. And the 404 is application/json from THIS Worker
# (classifyHost() refusing an unknown tenant slug), not an edge error page: the proxied wildcard DNS
# record and this route are both live, and a request for an arbitrary tenant host reaches this code.
#
# Note what that 404 does NOT prove: that any particular tenant serves. It proves the wildcard leg
# terminates TLS and routes here. Per-tenant liveness is a separate check.
#
# NOTE the asymmetry with the certificate: this pattern's `*` matches ACROSS dots, so a.b.<suffix>
# reaches this Worker while sitting OUTSIDE the one-label wildcard cert. classifyHost() refuses
# multi-label hosts explicitly rather than letting them fall through to a confusing dispatch miss.
[[routes]]
pattern = "*.${CONTROL_PLANE_HOST}/*"
zone_name = "${CONTROL_PLANE_ZONE_NAME}"
